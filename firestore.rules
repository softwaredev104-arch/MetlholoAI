rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.role == 'FARMER'
        && request.resource.data.subscriptionTier == 'FREE'
        && request.resource.data.status == 'active';

      allow read: if request.auth != null && request.auth.uid == userId;

      // During the current test build, allow the signed-in owner to promote
      // their own newly-created FREE account to PREMIUM only through the
      // explicit test entitlement path. Production payment entitlements
      // must be written by trusted backend/webhook code instead.
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && (
          request.resource.data.subscriptionTier == resource.data.subscriptionTier
          || (
            resource.data.subscriptionTier == 'FREE'
            && request.resource.data.subscriptionTier == 'PREMIUM'
            && request.resource.data.subscriptionProvider == 'test'
          )
        );

      allow delete: if false;
    }

    match /farms/{farmId} {
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
      allow read, update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }

    match /farms/{farmId}/{recordCollection}/{recordId} {
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.farmId == farmId;
      allow read, update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && resource.data.farmId == farmId;
    }

    // Public, published agricultural reference knowledge. Writes are ingestion/admin only.
    match /agriculturalCatalog/{productId} {
      allow read: if resource.data.publicationStatus == 'published';
      allow create, update, delete: if request.auth != null && request.auth.token.admin == true;
    }

    match /marketPrices/{priceId} {
      allow read: if resource.data.publicationStatus == 'published';
      allow create, update, delete: if request.auth != null && request.auth.token.admin == true;
    }

    match /cropGuidelines/{guidelineId} {
      allow read: if resource.data.publicationStatus == 'published';
      allow create, update, delete: if request.auth != null && request.auth.token.admin == true;
    }

    // Farmer-owned storefront data is separate from the reference catalog.
    match /marketplaceListings/{listingId} {
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.currency == 'BWP';
      allow read: if request.auth != null
        && (resource.data.ownerId == request.auth.uid || resource.data.status == 'published');
      allow update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}