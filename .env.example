# Firebase Authentication public client configuration
# Firebase is used for authentication in the current farm-data architecture.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Optional Google Drive connection.
# The current adapter is available on web through Google Identity Services.
# The app remains usable with local storage when this is not connected.
EXPO_PUBLIC_GOOGLE_DRIVE_CLIENT_ID=

# Agricultural intelligence service bases.
# A model is unavailable until its real deployed service base is configured.
EXPO_PUBLIC_AI_MAIZE_BASE_URL=
EXPO_PUBLIC_AI_CATTLE_BASE_URL=
EXPO_PUBLIC_AI_MAIZE_BEE_BASE_URL=
EXPO_PUBLIC_AI_GRAPE_BASE_URL=
EXPO_PUBLIC_AI_TOMATO_BASE_URL=
EXPO_PUBLIC_AI_SPINACH_BASE_URL=
EXPO_PUBLIC_AI_PEPPER_BASE_URL=
EXPO_PUBLIC_AI_POTATOES_BASE_URL=
EXPO_PUBLIC_AI_POULTRY_BASE_URL=
