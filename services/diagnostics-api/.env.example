# Dedicated Python container, not the Cloudflare Worker static frontend.
# Require Firebase bearer ID tokens outside local development.
METLHOLO_MODEL_REGISTRY_PATH=registry.json
METLHOLO_ALLOWED_ORIGINS=https://metlholoai-preview.jobebokang.workers.dev
METLHOLO_MAX_IMAGE_BYTES=8388608
# Only for isolated local tests; NEVER turn on for public deployments.
METLHOLO_DEV_NO_AUTH=false
# Optional self-hosted Roboflow Inference engine, not a hosted API key in Expo.
METLHOLO_ROBOFLOW_INFERENCE_URL=http://127.0.0.1:9001
# Optional server-only key if the selected model requires one.
ROBOFLOW_API_KEY=
